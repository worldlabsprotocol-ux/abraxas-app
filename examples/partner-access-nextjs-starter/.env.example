# Abraxas Partner Access — Next.js starter (reference only)
#
# Copy to .env.local for local development. Production partners must use their own
# secure session secret and HTTPS callback URLs allowlisted by Abraxas operators.

# Runtime isolation — starter routes are disabled unless explicitly opted in (default: off)
PARTNER_ACCESS_STARTER_ENABLED=false

# Operator-provisioned Partner Flow ids (required when enabled)
PARTNER_ACCESS_STARTER_PARTNER_ID=your-protocol-partner
PARTNER_ACCESS_STARTER_POLICY_ID=your-protocol-policy-v1

# Exact callback URL — must match partners.allowed_return_urls (no query/fragment)
# Local example (operators must allowlist this path on your sandbox partner):
PARTNER_ACCESS_STARTER_RETURN_URL=http://localhost:3000/examples/partner-access-starter/callback

# Abraxas public host (production default)
PARTNER_ACCESS_STARTER_ABRAXAS_BASE_URL=https://abraxasworld.xyz

# Optional display name for your integration
# PARTNER_ACCESS_STARTER_DISPLAY_NAME=Your Protocol

# Signed HttpOnly session — REQUIRED when enabled; use a long random secret in production
PARTNER_ACCESS_STARTER_SESSION_SECRET=change-me-to-a-long-random-string-in-production

# Sandbox/pilot policies only — set true when policy has production_usable: false
# PARTNER_ACCESS_STARTER_ALLOW_SANDBOX=false
