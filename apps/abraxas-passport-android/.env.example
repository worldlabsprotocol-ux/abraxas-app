# Abraxas Passport — Solana Mobile hackathon (no secrets in repo)
#
# Copy to .env.local for optional future production bridge (not required for sandbox demo).

# Set false on a Seeker/device with Seed Vault / Phantom Mobile to use real MWA
DEMO_MODE=true

# Future production Abraxas API (not used in sandbox MVP)
ABRAXAS_API_BASE=https://abraxasworld.xyz

# Future Solana RPC (optional; MVP does not require on-chain txs)
SOLANA_RPC_URL=https://api.devnet.solana.com

# NOT REQUIRED for hackathon demo — production receipt signing stays server-side
# ABRAXAS_SIGNING_KEY=
# ABRAXAS_PUBLIC_KEY=
