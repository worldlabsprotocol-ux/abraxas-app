{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "ONNXRUNTIME_NODE_INSTALL_CUDA=skip npm install && node scripts/prune-ml-binaries.js",
  "alias": ["abraxas-app.vercel.app"],
  "crons": [
    {
      "path": "/api/cron/bags-sync",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/asset-monitoring",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/partner-webhook-dispatch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/partner-webhook-health",
      "schedule": "*/15 * * * *"
    }
  ]
}
