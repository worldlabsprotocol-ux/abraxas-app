# Abraxas sovereign institutional runtime (no Supabase required for identity path)
# Copy to .env.local and replace secrets. Do not commit real values.

ABRAXAS_PERSISTENCE_BACKEND=postgres_direct
ABRAXAS_DATABASE_URL=postgresql://abraxas:change-me-sovereign@127.0.0.1:5432/abraxas_sovereign

# Encrypted identity evidence (filesystem or mounted volume)
ABRAXAS_EVIDENCE_STORAGE_ROOT=/var/abraxas/evidence
ABRAXAS_EVIDENCE_ENCRYPTION_KEY=

# Decision receipt / credential signing (Ed25519 private JWK JSON)
ABRAXAS_SIGNING_KEY=

# Build #552 encrypted backup (separate custody from evidence key)
ABRAXAS_BACKUP_ENCRYPTION_KEY=
ABRAXAS_BACKUP_SCOPE=sovereign
ABRAXAS_BACKUP_OUTPUT_DIR=/var/abraxas/backups

# Recovery drill target (disposable or isolated restore instance)
ABRAXAS_SOVEREIGN_RESTORE_PG_URL=

# PostgreSQL TLS (managed providers)
ABRAXAS_PG_SSL=require
ABRAXAS_PG_SSL_REJECT_UNAUTHORIZED=1
ABRAXAS_PG_POOL_MAX=8

# Admin / review (production)
ABRAXAS_ADMIN_EMAILS=
ABRAXAS_ADMIN_PIN=

# Optional: clear Supabase on sovereign-only identity services
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
