# Abraxas persistent sovereign staging (Build #558) — no Supabase trust dependency
# Copy to .env.local on the staging deployment host. Do not commit real values.

ABRAXAS_PERSISTENCE_BACKEND=postgres_direct
ABRAXAS_SOVEREIGN_ENV_CLASS=staging
ABRAXAS_SOVEREIGN_DATABASE_ID=abraxas_sovereign_staging
ABRAXAS_DATABASE_URL=postgresql://abraxas:@127.0.0.1:5432/abraxas_sovereign_staging

# Observed HTTP certification (deployed Next.js API base, no trailing slash)
ABRAXAS_STAGING_HTTP_BASE_URL=https://staging.example.abraxas.internal

# Schema apply — founder-only; never implicit from activation scripts
ABRAXAS_SOVEREIGN_MIGRATION_AUTHORIZED=false
ABRAXAS_SOVEREIGN_STAGING_SCHEMA_CHANGE_AUTHORIZED=false
ABRAXAS_SOVEREIGN_FOUNDER_STAGING_AUTHORIZATION=
ABRAXAS_SOVEREIGN_FOUNDER_STAGING_AUTHORIZATION_EXPECTED=

# Encrypted evidence + separate backup destination
ABRAXAS_EVIDENCE_STORAGE_ROOT=/var/abraxas/staging/evidence
ABRAXAS_EVIDENCE_ENCRYPTION_KEY=
ABRAXAS_BACKUP_ENCRYPTION_KEY=
ABRAXAS_BACKUP_SCOPE=sovereign
ABRAXAS_BACKUP_OUTPUT_DIR=/var/abraxas/staging/backups

# Independent restore target (never the primary database URL)
ABRAXAS_SOVEREIGN_RESTORE_PG_URL=postgresql://abraxas:@127.0.0.1:5433/abraxas_sovereign_staging_restore

# Decision receipt signing (Ed25519 private JWK JSON)
ABRAXAS_SIGNING_KEY=

# PostgreSQL TLS (managed providers — require for non-localhost)
ABRAXAS_PG_SSL=require
ABRAXAS_PG_SSL_REJECT_UNAUTHORIZED=1
ABRAXAS_PG_POOL_MAX=8

# Admin review on staging
ABRAXAS_ADMIN_EMAILS=
ABRAXAS_ADMIN_PIN=

# Omit Supabase on sovereign-only staging identity services
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
