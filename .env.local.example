# ============================================================================
# NextAuth — required for Google + GitHub OAuth login
# ============================================================================
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_ID=
GITHUB_SECRET=

# ============================================================================
# Bags API — server-side only, never bundled into the client
# Get them at https://dev.bags.fm
# ============================================================================
BAGS_API_KEY=
BAGS_PARTNER_KEY=
BAGS_PARTNER_WALLET=

# ============================================================================
# Public config (NEXT_PUBLIC_*) — bundled into client JS by Next.js.
# Only put non-secret values here.
# ============================================================================

# $ABRA token contract address (Solana SPL token mint)
NEXT_PUBLIC_ABRA_CA=5c1FHZj36pkA3cpXcyZxDhRmQyxzUqMNQn8K5neDBAGS
NEXT_PUBLIC_ABRA_MINT=5c1FHZj36pkA3cpXcyZxDhRmQyxzUqMNQn8K5neDBAGS
NEXT_PUBLIC_SOLSCAN_BASE=https://solscan.io/token

# OG ETH NFT collection (La Casa Distortion) — used for /access verification
NEXT_PUBLIC_OG_ETH_COLLECTION=0x99879b6bf05c893ba01f1bd18e042cf592a10210

# Solana RPC used by wallet adapter + balance fetching.
# Use Helius, QuickNode, or another paid provider — public RPC is rate-limited.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Ethereum mainnet RPC for NFT balance reads (optional — wagmi has a fallback).
# Use a paid provider in production.
NEXT_PUBLIC_ETH_RPC_URL=

# WalletConnect project ID for RainbowKit (optional but recommended).
# Get one free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ============================================================================
# Server-only RPC (separate from public if you want different keys)
# ============================================================================
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# X / Twitter OAuth 2.0
# Setup: https://developer.twitter.com/en/portal/projects
# Callback URL: https://abraxas-app.vercel.app/api/auth/callback/twitter
# Required scopes: tweet.read users.read offline.access
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

VAULT_AUTHORITY_PUBKEY=
VAULT_AUTHORITY_SECRET=

NEXT_PUBLIC_SUPABASE_URL=...
SUPABASE_SERVICE_ROLE_KEY=..