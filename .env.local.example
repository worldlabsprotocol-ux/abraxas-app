# =============================================================================
# Abraxas local development — copy to .env.local
# Never commit .env.local. Values below are empty or safe placeholders only.
# =============================================================================
#
# TIER LEGEND
#   [BUILD]     Required for `next build` / CI placeholders (nonfunctional alone)
#   [LOCAL-PF]  Partner Flow functional local setup (your Supabase + signing keys)
#   [LOCAL-PP]  Passport Google sign-in (adds Google OAuth client IDs to [LOCAL-PF])
#   [OPTIONAL]  Feature-specific; leave unset unless you need that feature
#   [PROD]      Production/server-only — set in Vercel, not committed
#
# Local signing/origin rule: use http://localhost:3000 — never abraxasworld.xyz
# for issuer examples in this file.
#
# Demo-only variables (PARTNER_SANDBOX_DEMO_*, DEMO_SUPABASE_*) belong in
# docs/demo/DEMO_VARIABLE_MATRIX.md — not in this generic local example.
# =============================================================================

# ── [BUILD][LOCAL-PF] Supabase (your authorized non-Production project) ───────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase service-role key. Use an authorized non-Production project locally.
SUPABASE_SERVICE_ROLE_KEY=

# ── [LOCAL-PF] App origin (localhost) ─────────────────────────────────────────
# Public browser-facing origin for cookies, redirects, and Reclaim callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Credential and receipt JWT issuer for local signing. Must match your local origin.
ABRAXAS_ISSUER_URL=http://localhost:3000

# ── [LOCAL-PF] Credential and receipt signing ─────────────────────────────────
# Generate keys: node scripts/generate-abraxas-key.js
# Server-only Ed25519 private JWK JSON.
ABRAXAS_SIGNING_KEY=
# Public JWK JSON (safe to expose via GET /api/credentials/public-key).
ABRAXAS_PUBLIC_KEY=
# Optional key id for rotation metadata.
# ABRAXAS_SIGNING_KEY_ID=
# Optional server-only secret for OAuth state cookies; falls back to ABRAXAS_SIGNING_KEY.
# ABRAXAS_BROWSER_SESSION_SECRET=

# ── [LOCAL-PP] zkLogin / Passport Google sign-in (not required for Partner Flow) ─
# See docs/ZKLOGIN_BACKEND_SETUP.md
NEXT_PUBLIC_GOOGLE_ZKLOGIN_CLIENT_ID=
# Server-only audience verification for zkLogin JWTs (same client id as above).
GOOGLE_ZKLOGIN_CLIENT_ID=
# Optional legacy recovery cohort client ids.
# NEXT_PUBLIC_GOOGLE_ZKLOGIN_LEGACY_CLIENT_ID=
# GOOGLE_ZKLOGIN_LEGACY_CLIENT_IDS=
# Optional Mysten prover URL for transaction proving.
# NEXT_PUBLIC_ZKLOGIN_PROVER_URL=https://prover-dev.mystenlabs.com/v1
# Optional pinned OAuth callback (defaults to current origin + /auth/zklogin/callback).
# NEXT_PUBLIC_ZKLOGIN_REDIRECT_URI=http://localhost:3000/auth/zklogin/callback

# ── [OPTIONAL] Admin (local/demo compatibility) ─────────────────────────────
# Local/demo PIN for POST /api/admin/session. Not used on Production-sensitive admin
# surfaces — those require an allowlisted browser session (ABRAXAS_ADMIN_EMAILS).
ADMIN_PIN=
# Comma-separated admin emails for identity review, production-sensitive admin routes,
# and partner webhook operational alerts. Distinct from legacy ADMIN_EMAIL below.
ABRAXAS_ADMIN_EMAILS=

# ── [OPTIONAL] Identity verification (default: Abraxas Verify / manual) ───────
IDV_PROVIDER=manual
# Legacy automated Veriff — only when IDV_PROVIDER=veriff.
# VERIFF_API_KEY=
# VERIFF_SECRET_KEY=
# VERIFF_SECRET=
VERIFF_DISABLED=true
VERIFF_BASE_URL=https://stationapi.veriff.com
# Optional Abraxas Verify biometric engine tuning.
# ABRAXAS_BIOMETRIC_AUTO_APPROVE=0
# ABRAXAS_CAPTURE_RATE_LIMIT_PER_HOUR=5
# ABRAXAS_BIOMETRIC_DOC_RETENTION_DAYS=90
# ABRAXAS_BIOMETRIC_ASSESSMENT_RETENTION_DAYS=365

# ── [OPTIONAL] Partner verifier API (v1 policy engine) ────────────────────────
# Local development allows keyless partner API access when unset.
# Deployed and prod-like environments should enforce authenticated partner APIs
# (set PARTNER_API_KEY or ABRAXAS_PARTNER_API_KEY; use REQUIRE_PARTNER_API_KEY=true).
# PARTNER_API_KEY=
# PARTNER_ID=abraxas

# ── [OPTIONAL] Sui network and on-chain passport ──────────────────────────────
# See docs/MAINNET_CUTOVER.md for mainnet cutover checklist.
SUI_NETWORK=devnet
NEXT_PUBLIC_SUI_NETWORK=devnet
# Optional server-side JSON-RPC override.
# SUI_RPC_URL=
# Optional GraphQL override.
# SUI_GRAPHQL_URL=
# Optional client RPC override.
# NEXT_PUBLIC_SUI_RPC_URL=
# Optional explorer base URL.
# SUI_EXPLORER_TX_BASE=https://suiscan.xyz/devnet/tx
# Server-only sponsor wallet export (suiprivkey…).
# SUI_SPONSOR_SECRET_KEY=
# On-chain issuance cap object id from npm run sui:mint-cap.
# SUI_ISSUANCE_CAP_OBJECT_ID=
# Sui treasury for Cielo USDC payments (0x address).
SUI_TREASURY_ADDRESS=

# ── [OPTIONAL] EVM / WalletConnect ────────────────────────────────────────────
# Create a project at https://cloud.reown.com (WalletConnect).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── [OPTIONAL] Social verify (Reclaim Protocol) ─────────────────────────────────
# Required for X / Google / GitHub / LinkedIn social verification.
# Without these, /api/reclaim/start returns 500.
RECLAIMPROTOCOL_APP_ID=
RECLAIMPROTOCOL_APP_SECRET=

# ── [OPTIONAL] Fiat on-ramp (MoonPay Platform) ────────────────────────────────
# Headless Apple Pay / card to USDC on Sui. Keys at https://dev.moonpay.com
MOONPAY_SECRET_KEY=
MOONPAY_DESTINATION_ASSET=USDC
MOONPAY_TEST_DESTINATION_ASSET=SOL
MOONPAY_TEST_WALLET=
# MOONPAY_API_BASE=https://api.moonpay.com

# ── [OPTIONAL] Fiat on-ramp (Ramp fallback) ───────────────────────────────────
RAMP_API_KEY=
RAMP_HOST_APP_NAME=
# RAMP_SWAP_ASSET=SUI_USDC
# RAMP_WIDGET_URL=https://app.ramp.network

# ── [OPTIONAL] Apple Wallet Pass (.pkpass) ────────────────────────────────────
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=

# ── [OPTIONAL] World ID ───────────────────────────────────────────────────────
NEXT_PUBLIC_WORLDID_APP_ID=
NEXT_PUBLIC_WORLDID_ACTION=

# ── [OPTIONAL] Solana verification program ────────────────────────────────────
NEXT_PUBLIC_SOLANA_RPC=
NEXT_PUBLIC_VERIFICATION_PROGRAM_ID=ABRAXASverify1111111111111111111111111111111

# ── [OPTIONAL] Price feeds and treasury labels ────────────────────────────────
CRYPTORANK_API_KEY=
NEXT_PUBLIC_CIRCUIT_WALLET=circuit.skr

# ── [OPTIONAL] Email notifications (Resend) ───────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
# Legacy notification-only recipient for asset/booking/music form submissions.
# Not used for admin auth or partner webhook operational alerts (use ABRAXAS_ADMIN_EMAILS).
ADMIN_EMAIL=

# ── [OPTIONAL] Mainnet gates and bounty (production operations) ───────────────
# ASSET_MONITORING_AUTO_APPLY=true
# INTEGRATION_SELF_SERVE=true
# SECURITY_BOUNTY_SUBMISSIONS=true
# BUG_BOUNTY_PHASE=live

# ── [PROD] Partner webhooks, cron, and rate limits (Vercel only) ──────────────
# Server-only webhook secret encryption key (never reuse ABRAXAS_SIGNING_KEY).
# ABRAXAS_WEBHOOK_MASTER_KEY=
# Server-only bearer for /api/cron/partner-webhook-dispatch.
CRON_SECRET=
# Set to true only after dispatch cron is live.
# PARTNER_WEBHOOK_DISPATCH_SCHEDULER_CONFIGURED=true
# Requires RESEND_API_KEY, EMAIL_FROM, and ABRAXAS_ADMIN_EMAILS.
# PARTNER_WEBHOOK_ALERTS_ENABLED=true
# Production partner-flow rate limiting (Upstash).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# PARTNER_FLOW_RATE_LIMIT_ENABLED=true

# ── [OPTIONAL] Tier 3 sandbox demo screening ──────────────────────────────────
# Demo screening is not real AML/sanctions clearance. Leave unset in production.
# PILOT_TIER3_SCREENING=false

# ── [BUILD] CI placeholders (nonfunctional — see README local development) ──────
# NEXTAUTH_SECRET=ci-build-placeholder-secret
# NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
