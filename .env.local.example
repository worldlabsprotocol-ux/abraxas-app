# ── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ─────────────────────────────────────────────────────────
NEXTAUTH_URL=https://abraxas-app.vercel.app
NEXTAUTH_SECRET=                         # openssl rand -base64 32

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=                   # Resend API key
EMAIL_FROM=noreply@abraxas-app.vercel.app

# ── Solana ────────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_RPC=                  # helius/quicknode mainnet RPC
NEXT_PUBLIC_VERIFICATION_PROGRAM_ID=ABRAXASverify1111111111111111111111111111111

# ── Admin ────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_PIN=abraxas2026

# ── EVM / WalletConnect (mobile browsers without window.ethereum) ─
# Create a project at https://cloud.reown.com (WalletConnect)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Price feeds ──────────────────────────────────────────────────
CRYPTORANK_API_KEY=
CRON_SECRET=

# Wallet for CIRCUIT-related payments (Cielo USDC on Sui treasury label)
NEXT_PUBLIC_CIRCUIT_WALLET=circuit.skr

# Sui treasury for Cielo USDC payments (0x address — defaults to sponsor wallet if unset)
SUI_TREASURY_ADDRESS=

# ── Sui / Passport (mainnet cutover) ─────────────────────────────
# See docs/MAINNET_CUTOVER.md for ordered gate checklist.
SUI_NETWORK=devnet
NEXT_PUBLIC_SUI_NETWORK=devnet
# SUI_RPC_URL=                         # optional override
# SUI_EXPLORER_TX_BASE=https://suiscan.xyz/devnet/tx

# Sponsor wallet (issues on-chain Passport after Veriff)
# Export with: sui keytool export --key-identity <address>
SUI_SPONSOR_SECRET_KEY=                  # suiprivkey1… full export, no quotes
SUI_ISSUANCE_CAP_OBJECT_ID=              # 0x + 64 hex from npm run sui:mint-cap

# Mainnet gate #6
# ASSET_MONITORING_AUTO_APPLY=true

# Mainnet gate #7 (self-serve integrate + ops notify)
# INTEGRATION_SELF_SERVE=true
# SECURITY_BOUNTY_SUBMISSIONS=true
RESEND_API_KEY=
ADMIN_EMAIL=

# Optional: flip to live after audits publish (gate #7 full bounty)
# BUG_BOUNTY_PHASE=live

# ── Fiat on-ramp (MoonPay Platform — preferred) ─────────────────
# Headless Apple Pay / card → USDC on Sui. Get keys at https://dev.moonpay.com
MOONPAY_SECRET_KEY=                       # sk_test_… or sk_live_… — server only, never expose to frontend
MOONPAY_DESTINATION_ASSET=USDC            # live mode: crypto asset code for quotes (USDC on Sui)
MOONPAY_TEST_DESTINATION_ASSET=SOL        # test mode: SOL/ETH supported on testnets (not Sui USDC)
MOONPAY_TEST_WALLET=                      # optional Solana testnet address for sk_test_ quotes
# MOONPAY_API_BASE=https://api.moonpay.com
# Allowlist abraxas-app.vercel.app at https://dashboard.moonpay.com/developers

# ── Fiat on-ramp (Ramp — fallback if MoonPay not set) ───────────
RAMP_API_KEY=
RAMP_HOST_APP_NAME=
# RAMP_SWAP_ASSET=SUI_USDC
# RAMP_WIDGET_URL=https://app.ramp.network

# ── Apple Wallet Pass (.pkpass) ─────────────────────────────────
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=

NEXT_PUBLIC_WORLDID_APP_ID=
NEXT_PUBLIC_WORLDID_ACTION=

# ── Verification: social login (Reclaim Protocol) ────────────────
# Required for X / Google / GitHub / LinkedIn "Social Verified" to work.
# Get these from the Reclaim Protocol developer dashboard. Without them,
# /api/reclaim/start returns 500 ("Could not start verification").
RECLAIMPROTOCOL_APP_ID=
RECLAIMPROTOCOL_APP_SECRET=
# Public base URL of the deployment, used to build the Reclaim callback
# (e.g. https://abraxas-app.vercel.app). Must be publicly reachable.
NEXT_PUBLIC_APP_URL=

# ── Verification: identity ─────────────────────────────────────
# Abraxas independent (recommended): IDV_PROVIDER=manual — camera capture + human review
# Veriff (automated): set VERIFF_API_KEY or IDV_PROVIDER=veriff
IDV_PROVIDER=manual
VERIFF_DISABLED=true
# Ed25519 JWK for JWT credential issuance (generate with jose or openssl)
# Optional: Abraxas Verify biometric engine (v1) — keep auto-approve OFF in production initially
# ABRAXAS_BIOMETRIC_AUTO_APPROVE=0
# ABRAXAS_CAPTURE_RATE_LIMIT_PER_HOUR=5
# ABRAXAS_BIOMETRIC_DOC_RETENTION_DAYS=90
# ABRAXAS_BIOMETRIC_ASSESSMENT_RETENTION_DAYS=365
ABRAXAS_SIGNING_KEY=
# Optional; falls back to ABRAXAS_SIGNING_KEY for capture session cookies
ABRAXAS_BROWSER_SESSION_SECRET=
VERIFF_API_KEY=
VERIFF_SECRET_KEY=
VERIFF_SECRET=                         # Webhook HMAC (station API)
VERIFF_BASE_URL=https://stationapi.veriff.com

# ── Partner verifier API (v1 policy engine) ─────────────────────
PARTNER_API_KEY=                          # X-API-Key for /api/v1/* partner routes
PARTNER_ID=abraxas                        # Partner identifier in audit logs

# ── Tier 3 sandbox demo screening ───────────────────────────────
# Leave unset or false in production. Demo screening is not real AML/sanctions clearance.
# PILOT_TIER3_SCREENING=false
