# BUILD #962 — non-production institutional worker (self-hosted-file).
# Install as /etc/abraxas/institutional-worker.env — never commit real secrets.
#
# Do NOT set ABRAXAS_GOVERNANCE_OPERATOR_PG_URL here.
# Do NOT set AWS KMS variables unless intentionally using aws-kms provider.
# Do NOT set ABRAXAS_*_PRIVATE_JWK.

ABRAXAS_INSTITUTIONAL_SIGNING_WORKER=1
ABRAXAS_INSTITUTIONAL_WORKER_ENVIRONMENT=demo
ABRAXAS_INSTITUTIONAL_CUSTODY_PROVIDER=self-hosted-file
ABRAXAS_INSTITUTIONAL_WORKER_LISTEN_HOST=127.0.0.1
ABRAXAS_INSTITUTIONAL_WORKER_LISTEN_PORT=3848

ABRAXAS_SELF_HOSTED_ISSUER_SEED_PATH=/var/abraxas/np/issuer.seed
ABRAXAS_SELF_HOSTED_STATUS_SEED_PATH=/var/abraxas/np/status.seed
ABRAXAS_ISSUER_AUTHORITY_ANCHOR_KEY_ID=np-anchor
ABRAXAS_STATUS_SIGNER_KEY_ID=np-status

ABRAXAS_WORKER_CALLER_STATUS_SCOPE=institution_wide
ABRAXAS_WORKER_CALLER_STATUS_SECRET=replace-with-openssl-rand
ABRAXAS_WORKER_CALLER_ISSUER_SECRET=replace-with-openssl-rand
ABRAXAS_WORKER_CALLER_AUTHORITY_SECRET=replace-with-openssl-rand
ABRAXAS_WORKER_CALLER_HEALTH_SECRET=replace-with-openssl-rand

# Optional public JWKs for bootstrap hints (private material remains in seed files only)
# ABRAXAS_ISSUER_AUTHORITY_ANCHOR_PUBLIC_JWK={"kty":"OKP",...}
# ABRAXAS_STATUS_SIGNER_PUBLIC_JWK={"kty":"OKP",...}