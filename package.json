{
  "name": "abraxas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "DOTENV_CONFIG_PATH=.env.local npx ts-node -r dotenv/config scripts/seed.ts",
    "sui:build": "sui move build --path sui/abraxas_passport",
    "sui:deploy:devnet": "bash scripts/sui/deploy-devnet.sh",
    "sui:mint-cap": "bash scripts/sui/mint-issuance-cap.sh",
    "cielo:e2e": "DOTENV_CONFIG_PATH=.env.local npx ts-node -r dotenv/config scripts/cielo-e2e-check.ts",
    "cielo:e2e:remote": "BASE_URL=https://abraxas-app.vercel.app npx ts-node scripts/cielo-e2e-check.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@moonpay/platform-sdk-web": "^1.6.0",
    "@mysten/sui": "^1.45.2",
    "@reclaimprotocol/js-sdk": "^5.5.0",
    "@solana/spl-token": "^0.4.8",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-solflare": "^0.6.33",
    "@solana/wallet-adapter-wallets": "^0.19.38",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-query": "^5.101.2",
    "framer-motion": "^12.42.0",
    "jose": "^6.2.3",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "stripe": "^16.0.0",
    "tweetnacl": "^1.0.3",
    "viem": "^2.23.2",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "encoding": "^0.1.13",
    "pino-pretty": "^11.2.2",
    "postcss": "^8.4.39",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7"
  },
  "resolutions": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.3"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
