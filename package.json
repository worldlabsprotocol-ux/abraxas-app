{
  "name": "abraxas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "DOTENV_CONFIG_PATH=.env.local npx ts-node -r dotenv/config scripts/seed.ts",
    "sui:build": "sui move build --path sui/abraxas_passport",
    "sui:deploy:devnet": "bash scripts/sui/deploy-devnet.sh",
    "sui:deploy:mainnet": "bash scripts/sui/deploy-mainnet.sh",
    "sui:mint-cap": "bash scripts/sui/mint-issuance-cap.sh",
    "sui:install-cli": "bash scripts/sui/install-cli.sh",
    "sui:setup-devnet": "bash scripts/sui/setup-sponsor-devnet.sh",
    "cielo:e2e": "DOTENV_CONFIG_PATH=.env.local npx ts-node -r dotenv/config scripts/cielo-e2e-check.ts",
    "cielo:e2e:remote": "BASE_URL=https://abraxas-app.vercel.app npx ts-node scripts/cielo-e2e-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "biometric:verify-migrations": "npx tsx scripts/verify-biometric-migrations.ts",
    "biometric:health": "npx tsx scripts/verify-biometric-health.ts",
    "biometric:download-model": "bash scripts/download-face-embedding-model.sh",
    "biometric:analyze-bundle": "node scripts/analyze-capture-bundle.js",
    "biometric:validate-policy": "npx tsx scripts/validate-good-trouble-policy.ts",
    "audit:production": "npx tsx scripts/production-readiness-audit.ts",
    "audit:partner-flow-trace": "npx tsx scripts/partner-flow-trace-audit.ts",
    "gate:preflight": "npx tsx scripts/beta-gate-preflight.ts",
    "integration:preflight": "npx tsx scripts/integration-preflight.ts",
    "partner:conformance": "npx tsx scripts/partner-conformance.ts",
    "iat:automated": "npx tsx scripts/iat-automated.ts",
    "gate:verify-receipt-fixture": "npx tsx scripts/verify-trust-decision-fixture.ts",
    "check:homepage": "vitest run lib/home/homepageBaseline.test.ts lib/home/protocolProofLogos.test.ts",
    "check:homepage-guard": "npx tsx scripts/homepage-guard/check.ts",
    "homepage:baseline:refresh": "npx tsx scripts/homepage-guard/refresh-baseline.ts --approved",
    "identity:verify-schema": "npx tsx scripts/verify-admin-identity-schema.ts",
    "wallet-binding:verify-schema": "npx tsx scripts/verify-wallet-binding-schema.ts",
    "identity:seed-review-queue": "npx tsx scripts/seed-identity-review-queue.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@moonpay/platform-sdk-web": "^1.6.0",
    "@mysten/sui": "^1.45.2",
    "@reclaimprotocol/js-sdk": "^5.5.0",
    "@solana/spl-token": "^0.4.8",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-solflare": "^0.6.33",
    "@solana/wallet-adapter-wallets": "^0.19.38",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-query": "^5.101.2",
    "@walletconnect/ethereum-provider": "^2.19.1",
    "framer-motion": "^12.42.0",
    "jose": "^6.2.3",
    "next": "14.2.35",
    "onnxruntime-node": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "stripe": "^16.0.0",
    "tweetnacl": "^1.0.3",
    "viem": "^2.23.2",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "encoding": "^0.1.13",
    "pino-pretty": "^11.2.2",
    "postcss": "^8.4.39",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7"
  },
  "resolutions": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.3"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
