# Build #561 — portable sovereign runtime (VPS, dedicated server, founder hardware)
# Pair with docker-compose.sovereign.portable.yml and npm run build && npm start (Node 24+).

ABRAXAS_PERSISTENCE_BACKEND=postgres_direct
ABRAXAS_SOVEREIGN_ENV_CLASS=disposable
ABRAXAS_SOVEREIGN_DATABASE_ID=abraxas_sovereign_disposable
ABRAXAS_DATABASE_URL=postgresql://abraxas:@127.0.0.1:5432/abraxas_sovereign
ABRAXAS_SOVEREIGN_RESTORE_PG_URL=postgresql://abraxas:@127.0.0.1:5433/abraxas_sovereign_restore

ABRAXAS_EVIDENCE_STORAGE_ROOT=./data/evidence
ABRAXAS_EVIDENCE_ENCRYPTION_KEY=
ABRAXAS_BACKUP_ENCRYPTION_KEY=
ABRAXAS_BACKUP_SCOPE=sovereign
ABRAXAS_BACKUP_OUTPUT_DIR=./data/backups

ABRAXAS_SIGNING_KEY=
ABRAXAS_BROWSER_SESSION_SECRET=

IDV_PROVIDER=manual

# Do not set Supabase on sovereign core deployments:
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

ABRAXAS_SOVEREIGN_MIGRATION_AUTHORIZED=false
